{
  "name": "blackmagic-controller-packages",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "run build:root --watch",
    "dev:demo": "yarn workspace @blackmagic-controller/web-demo start",
    "build": "run build:root && run build:udev",
    "build:root": "(rimraf packages/*/dist || true) && tsc --build tsconfig.build.json",
    "build:udev": "node ./scripts/regenerate-udev.mjs",
    "test": "run lint && run unit",
    "unit": "vitest run",
    "lint:raw": "eslint",
    "lint": "run lint:raw packages",
    "lint-fix": "run lint --fix",
    "validate:dependencies": "yarn npm audit"
  },
  "lint-staged": {
    "*.{css,json,md,scss}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "yarn lint:raw --fix"
    ]
  },
  "devDependencies": {
    "@companion-module/tools": "^2.8.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^20.19.43",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "udev-generator": "^1.0.3",
    "usb": "^2.19.1",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/core",
    "packages/node",
    "packages/web",
    "packages/web-demo"
  ],
  "packageManager": "yarn@4.12.0"
}
